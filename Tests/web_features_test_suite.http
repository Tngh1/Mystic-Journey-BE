# ==============================================================================
# Mystic Journey Web API Test Suite (22 Features / 44 Sub-Functions)
# Compatible with Visual Studio HTTP Editor, VS Code REST Client, & Swagger UI
# ==============================================================================

@host = http://localhost:5176
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
@contentType = application/json

# ==============================================================================
# F01 - Register (FUNC_AUTH_001)
# ==============================================================================
### F01.1: Register New Account
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "testuser_web01@example.com",
  "username": "webuser01",
  "password": "Password123!",
  "confirmPassword": "Password123!",
  "otpCode": "123456"
}

# ==============================================================================
# F02 - Login (FUNC_AUTH_002)
# ==============================================================================
### F02.1: Login to Account (Capture AccessToken)
# @name login
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "emailOrUsername": "admin@mysticjourney.com",
  "password": "AdminPassword123!",
  "clientType": "Web"
}

# ==============================================================================
# F03 - Forgot Password (FUNC_AUTH_003)
# ==============================================================================
### F03.1: Request Forgot Password Verification Code
POST {{host}}/api/auth/forgot-password
Content-Type: {{contentType}}

{
  "email": "testuser_web01@example.com"
}

# ==============================================================================
# F04 - Change Password (FUNC_AUTH_004)
# ==============================================================================
### F04.1: Change Password for Account
POST {{host}}/api/auth/change-password
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "oldPassword": "Password123!",
  "newPassword": "NewPassword123!",
  "confirmNewPassword": "NewPassword123!"
}

# ==============================================================================
# F05 - Logout (FUNC_AUTH_005)
# ==============================================================================
### F05.1: Logout Current Session
POST {{host}}/api/auth/logout
Authorization: Bearer {{authToken}}

# ==============================================================================
# F06 - View Game Information (FUNC_INFO_001)
# ==============================================================================
### F06.1: Get Overview Game Settings & Dashboard Stats
GET {{host}}/api/dashboard/stats
Authorization: Bearer {{authToken}}

# ==============================================================================
# F07 - View Account Profile (FUNC_ACC_001)
# ==============================================================================
### F07.1: View Personal Account Profile
GET {{host}}/api/adminaccounts/profile
Authorization: Bearer {{authToken}}

# ==============================================================================
# F08 - Player Management (FUNC_PLR_001 to 004)
# ==============================================================================
### F08.1: View Player List (Pagination, Search, Filter)
GET {{host}}/api/playerprofiles?page=1&pageSize=10&search=Hero&isActive=true
Authorization: Bearer {{authToken}}

### F08.2: View Player Profile Detail
GET {{host}}/api/playerprofiles/1
Authorization: Bearer {{authToken}}

### F08.3: Ban Player Account
POST {{host}}/api/playerprofiles/1/ban
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "reason": "Violating terms of service / Cheating",
  "banDurationDays": 7
}

### F08.4: Unban Player Account
POST {{host}}/api/playerprofiles/1/unban
Authorization: Bearer {{authToken}}

# ==============================================================================
# F09 - Category Management (FUNC_CAT_001 to 003)
# ==============================================================================
### F09.1: View Category List
GET {{host}}/api/contents/categories
Authorization: Bearer {{authToken}}

### F09.2: Create Category Content
POST {{host}}/api/contents/categories
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Game Updates & Events",
  "description": "Category for official game updates, maintenance news, and special events."
}

### F09.3: Update Category Content
PUT {{host}}/api/contents/categories/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Updated Game News",
  "description": "Updated category description."
}

# ==============================================================================
# F10 - Content Management (FUNC_CNT_001 to 003)
# ==============================================================================
### F10.1: View Content List
GET {{host}}/api/contents?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### F10.2: Create Content (Draft & Publish Article)
POST {{host}}/api/contents
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Welcome to Version 1.0 Release!",
  "content": "Full article details about version 1.0 update.",
  "categoryId": 1,
  "isPublished": true
}

### F10.3: Update Content
PUT {{host}}/api/contents/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Version 1.0 Patch Notes (Updated)",
  "content": "Updated content body.",
  "categoryId": 1,
  "isPublished": true
}

# ==============================================================================
# F11 - Item Management (FUNC_ITM_001 to 002)
# ==============================================================================
### F11.1: View Item List
GET {{host}}/api/items?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### F11.2: Update Item Stats
PUT {{host}}/api/items/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Excalibur Sword",
  "description": "Legendary sword of power.",
  "attack": 150,
  "defense": 20,
  "rarity": "SSR"
}

# ==============================================================================
# F12 - Monster Management (FUNC_MON_001 to 002)
# ==============================================================================
### F12.1: View Monster List
GET {{host}}/api/monsters?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### F12.2: Update Monster Stats
PUT {{host}}/api/monsters/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Inferno Dragon Boss",
  "hp": 50000,
  "attack": 1200,
  "defense": 350,
  "expReward": 5000
}

# ==============================================================================
# F13 - Gacha Management (FUNC_GCH_001 to 002)
# ==============================================================================
### F13.1: View Gacha Banners List
GET {{host}}/api/gachabanners
Authorization: Bearer {{authToken}}

### F13.2: Update Gacha Pool Configuration
PUT {{host}}/api/gachabanners/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "bannerName": "Summer Limited Legend Banner",
  "ssrRate": 0.03,
  "srRate": 0.15,
  "isActive": true
}

# ==============================================================================
# F14 - Shop Item Management (FUNC_SHP_001 to 003)
# ==============================================================================
### F14.1: View Shop Item List
GET {{host}}/api/shopitems?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### F14.2: Create Shop Item
POST {{host}}/api/shopitems
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "itemId": 1,
  "price": 100,
  "currencyType": "Gem",
  "stockLimit": 50
}

### F14.3: Update Shop Item Price/Status
PUT {{host}}/api/shopitems/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "price": 90,
  "discountPercent": 10,
  "isAvailable": true
}

# ==============================================================================
# F15 - Transaction History (FUNC_TRX_001)
# ==============================================================================
### F15.1: View Transaction List
GET {{host}}/api/purchasehistories?page=1&pageSize=10
Authorization: Bearer {{authToken}}

# ==============================================================================
# F16 - Dungeon Config Management (FUNC_DNG_001 to 002)
# ==============================================================================
### F16.1: View Dungeon List
GET {{host}}/api/dungeons
Authorization: Bearer {{authToken}}

### F16.2: Update Dungeon Config
PUT {{host}}/api/dungeons/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Abyssal Cavern - Hard Mode",
  "staminaCost": 15,
  "requiredLevel": 30,
  "rewardGold": 2500
}

# ==============================================================================
# F17 - Quest Management (FUNC_QST_001 to 004)
# ==============================================================================
### F17.1: View Quest List
GET {{host}}/api/quests?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### F17.2: View Quest Detail
GET {{host}}/api/quests/1
Authorization: Bearer {{authToken}}

### F17.3: Create Quest
POST {{host}}/api/quests
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Defeat 10 Goblins",
  "description": "Slay 10 goblins in the wild forest to protect the village.",
  "targetCount": 10,
  "rewardExp": 1000,
  "rewardGold": 500
}

### F17.4: Update Quest
PUT {{host}}/api/quests/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Defeat 15 Goblins (Updated)",
  "description": "Slay 15 goblins in the wild forest.",
  "targetCount": 15,
  "rewardExp": 1500,
  "rewardGold": 750
}

# ==============================================================================
# F18 - Achievement Management (FUNC_ACH_001 to 002)
# ==============================================================================
### F18.1: View Achievement List
GET {{host}}/api/achievements
Authorization: Bearer {{authToken}}

### F18.2: Update Achievement Targets/Rewards
PUT {{host}}/api/achievements/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "title": "Master Slayer I",
  "targetProgress": 100,
  "rewardGems": 50
}

# ==============================================================================
# F19 - Mail Management (FUNC_MAL_001 to 002)
# ==============================================================================
### F19.1: View Mailbox List
GET {{host}}/api/mailboxes?page=1&pageSize=10
Authorization: Bearer {{authToken}}

### F19.2: Send Mail to Players
POST {{host}}/api/mailboxes/send
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "recipientType": "All",
  "title": "Maintenance Compensation Reward",
  "content": "Thank you for your patience during system update. Enjoy 500 Gems!",
  "rewardGold": 10000,
  "rewardGems": 500
}

# ==============================================================================
# F20 - Daily Login Management (FUNC_DLR_001 to 003)
# ==============================================================================
### F20.1: View Daily Login Rewards
GET {{host}}/api/dailyloginrewards
Authorization: Bearer {{authToken}}

### F20.2: Create Daily Login Campaign
POST {{host}}/api/dailyloginrewards/campaigns
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "campaignName": "7-Day Festival Login Campaign",
  "totalDays": 7,
  "startDate": "2026-08-01T00:00:00Z",
  "endDate": "2026-08-31T23:59:59Z"
}

### F20.3: Update Daily Login Campaign
PUT {{host}}/api/dailyloginrewards/campaigns/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "campaignName": "Updated 7-Day Festival Login Campaign",
  "totalDays": 7
}

# ==============================================================================
# F21 - Statistics Dashboard (FUNC_STAT_001)
# ==============================================================================
### F21.1: View Statistical Charts (Revenue, DAU/MAU, Retention)
GET {{host}}/api/dashboard/statistics?range=30days
Authorization: Bearer {{authToken}}

# ==============================================================================
# F22 - Admin Management (FUNC_ADM_001 to 003)
# ==============================================================================
### F22.1: View Admin List
GET {{host}}/api/adminaccounts
Authorization: Bearer {{authToken}}

### F22.2: Create Admin Account
POST {{host}}/api/adminaccounts
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "email": "newadmin@mysticjourney.com",
  "username": "manager_admin01",
  "password": "AdminPassword123!",
  "role": "Manager"
}

### F22.3: Update Admin Permissions / Status
PUT {{host}}/api/adminaccounts/1
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "role": "SuperAdmin",
  "isActive": true
}
